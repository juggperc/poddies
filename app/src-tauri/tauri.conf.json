{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poddies",
  "version": "0.1.0",
  "identifier": "dev.poddies.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Poddies",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": true,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active",
          "radius": 10.0
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Poddies",
    "copyright": "MIT licensed",
    "shortDescription": "An ultra-minimal podcast client.",
    "longDescription": "Poddies is an ultra-minimal podcast client for Windows: a compact three-pane window over a Mica background, a transparent discovery queue, and a sandboxed plugin system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../plugins/poddies-plugin-stats/plugin.json": "plugins/dev.poddies.stats/plugin.json",
      "../../plugins/poddies-plugin-stats/poddies_plugin_stats.dll": "plugins/dev.poddies.stats/poddies_plugin_stats.dll",
      "../../plugins/poddies-plugin-apple-podcasts/plugin.json": "plugins/dev.poddies.apple-podcasts/plugin.json",
      "../../plugins/poddies-plugin-apple-podcasts/poddies_plugin_apple_podcasts.dll": "plugins/dev.poddies.apple-podcasts/poddies_plugin_apple_podcasts.dll",
      "../../python/poddies/__init__.py": "python/poddies/__init__.py"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
