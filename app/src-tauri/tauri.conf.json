{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poddies",
  "version": "0.1.0",
  "identifier": "dev.poddies.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Poddies",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": true,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active",
          "radius": 10.0
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
